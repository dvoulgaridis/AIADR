# Optional local overrides

# Network
# Allows network clients permitted by the host firewall
# Use only on a trusted LAN or private VPN
AIADR_ALLOW_LAN=false
AIADR_SERVER_PORT=7860

# Runtime data directory relative to working directory
AIADR_DATA_DIR=data

# Operational limits
AIADR_MAX_UPLOAD_MB=50
AIADR_DOCX_WORKERS=2

# Leave empty to discover ffmpeg and ffprobe on PATH
AIADR_FFMPEG_PATH=

# Leave empty to discover LibreOffice on PATH or in its standard install location
AIADR_LIBREOFFICE_PATH=

# Leave empty to use a generated secret in AIADR_DATA_DIR/settings
AIADR_EXPORT_HMAC_SECRET=

# Logging
AIADR_LOG_LEVEL=INFO
